{
  "name": "rose-desktop",
  "private": true,
  "version": "0.25.0",
  "main": "main.js",
  "scripts": {
    "install-deps": "node ../scripts/install.mjs --app .",
    "setup": "node ../scripts/setup.mjs",
    "doctor": "node ../scripts/doctor.mjs",
    "prestart": "node ../scripts/brand-dev-app.mjs || true",
    "start": "electron .",
    "dist": "npm run setup && electron-builder",
    "dist:mac": "npm run setup && electron-builder --mac",
    "dist:win": "npm run setup && electron-builder --win"
  },
  "build": {
    "appId": "com.rose.desktop",
    "productName": "ROSE",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "services.js",
      "core/**/*",
      "UI/**/*",
      "package.json",
      "!core/.codex-home/**",
      "!core/vendor/**",
      "!**/*.map",
      "build/icon.png",
      "!UI/logo/png/**",
      "!UI/logo/options/**"
    ],
    "extraResources": [
      {
        "from": "../defaults",
        "to": "defaults"
      },
      {
        "from": "../runtime",
        "to": "runtime"
      },
      {
        "from": "mcp",
        "to": "mcp"
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "extraResources": [
        {
          "from": "core/vendor",
          "to": "vendor",
          "filter": [
            "codex-aarch64-apple-darwin"
          ]
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-win-x64.${ext}",
      "icon": "build/icon.ico",
      "extraResources": [
        {
          "from": "core/vendor",
          "to": "vendor",
          "filter": [
            "codex.exe",
            "codex-command-runner.exe",
            "codex-windows-sandbox-setup.exe"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ROSE",
      "uninstallDisplayName": "ROSE",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ],
      "language": "2052"
    },
    "portable": {
      "artifactName": "${productName}-${version}-win-x64-portable.${ext}"
    },
    "dmg": {
      "title": "ROSE"
    }
  },
  "devDependencies": {
    "electron": "^37.0.0",
    "electron-builder": "^26.0.0"
  }
}
